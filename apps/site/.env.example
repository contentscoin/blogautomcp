# Managed PostgreSQL connection. No separate application server is required.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/blogautomcp?sslmode=require"

# Public deployed origin, without a trailing slash.
SITE_URL="http://localhost:3100"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITE_AUTH_SECRET="replace-with-at-least-32-random-bytes"

# The only administrator identity. This value is also fixed in source as a safety check.
ADMIN_EMAIL="hiway@kakao.com"

# One-time code required when the administrator account is registered for the first time.
ADMIN_BOOTSTRAP_CODE="replace-with-a-long-random-bootstrap-code"
