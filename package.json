{
  "name": "brandconnect-automation",
  "version": "1.0.0",
  "description": "네이버 쇼핑 커넥트(브랜드커넥트) 자동 블로그 포스팅 도구",
  "private": true,
  "author": "Jake Shin <ninano112@gmail.com>",
  "scripts": {
    "dev": "next dev",
    "dev:open": "node scripts/dev-open.mjs",
    "desktop": "electron .",
    "desktop:dev": "cross-env APP_PORT=3000 APP_HOST=127.0.0.1 electron .",
    "db:template": "cross-env DATABASE_URL=file:./template.db prisma db push --skip-generate --accept-data-loss",
    "desktop:prepack": "npm run db:template && npm run build",
    "desktop:pack": "npm run desktop:prepack && electron-builder --publish=never",
    "desktop:pack:mac": "npm run desktop:prepack && electron-builder --mac --publish=never",
    "desktop:pack:win": "npm run desktop:prepack && electron-builder --win --publish=never",
    "desktop:pack:linux": "npm run desktop:prepack && electron-builder --linux --publish=never",
    "build": "prisma generate && next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "login": "npx ts-node --project tsconfig.scripts.json scripts/login.ts",
    "login:chatgpt": "npx ts-node --project tsconfig.scripts.json scripts/chatgpt-login.ts",
    "check:chatgpt": "npx ts-node --project tsconfig.scripts.json scripts/chatgpt-healthcheck.ts",
    "publish": "npx ts-node --project tsconfig.scripts.json scripts/simple-agent.ts",
    "review": "npx ts-node --project tsconfig.scripts.json scripts/review-agent.ts",
    "topic": "cross-env TOPIC_AGENT_ALLOW_LEGACY_GENERATION=true npx ts-node --project tsconfig.scripts.json scripts/topic-agent.ts",
    "brandconnect:seasonal": "npx ts-node --project tsconfig.scripts.json scripts/brandconnect-seasonal-register.ts",
    "publish:bulk-schedule": "npx ts-node --project tsconfig.scripts.json scripts/bulk-schedule-publish.ts",
    "db:studio": "npx prisma studio",
    "db:push": "npx prisma db push"
  },
  "main": "scripts/electron/main.cjs",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^17.2.3",
    "next": "16.1.3",
    "openai": "^6.16.0",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "prisma": "^5.22.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "20.19.30",
    "@types/react": "19.2.10",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "electron": "^34.1.4",
    "electron-builder": "^26.0.9",
    "tailwindcss": "^4"
  },
  "build": {
    "appId": "com.jakeshin.naver-bc-automation",
    "productName": "BrandConnect Automation",
    "asar": false,
    "directories": {
      "output": "out",
      "buildResources": "resources"
    },
    "files": [
      "scripts/**/*",
      ".next/**/*",
      "!.next/cache/**",
      "!.next/dev/**",
      "public/**/*",
      "next.config.ts",
      "package.json",
      "node_modules/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/.bin/prisma*",
      "prisma/**/*",
      "src/**/*",
      "styles/**/*",
      "next-env.d.ts",
      "tsconfig.json",
      "tsconfig.scripts.json",
      "!**/*.tsbuildinfo",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "scripts/electron/main.cjs"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "signIgnore": [
        "puppeteer-extra-plugin-stealth/evasions/chrome\\.app"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma"
      }
    ],
    "npmRebuild": false
  }
}
