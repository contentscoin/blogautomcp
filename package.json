{
  "name": "brandconnect-automation",
  "version": "1.3.87",
  "description": "네이버 쇼핑 커넥트(브랜드커넥트) 자동 블로그 포스팅 도구",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:open": "node scripts/dev-open.mjs",
    "desktop": "electron .",
    "desktop:dev": "cross-env APP_PORT=43127 APP_HOST=127.0.0.1 electron .",
    "desktop:pack": "npm run build && electron-builder --publish=never",
    "desktop:pack:mac": "npm run build && electron-builder --mac --publish=never",
    "desktop:pack:win": "node scripts/check-packaging-target.cjs && npm run build && electron-builder --win --publish=never",
    "desktop:pack:linux": "npm run build && electron-builder --linux --publish=never",
    "build": "prisma generate && node scripts/cleanup-prisma-generated-temp.mjs && next build --webpack",
    "typecheck": "tsc --noEmit",
    "test:material-regression": "node scripts/verify-material-regression.mjs",
    "test:mcp-activation": "node scripts/verify-mcp-activation-e2e.mjs",
    "test:mcp-delivery": "node --test src/lib/remote-agent-completion.test.cjs apps/sites/tests/*.test.cjs",
    "test:draft-ui": "tsx --test src/app/draft-approval-ui.test.ts",
    "test:saved-text-revalidation": "ts-node --project tsconfig.scripts.json scripts/verify-saved-text-revalidation.ts",
    "test:shopping-workflow": "ts-node --project tsconfig.scripts.json scripts/verify-shopping-source-safety.ts && ts-node --project tsconfig.scripts.json scripts/verify-published-text-layout.ts && ts-node --project tsconfig.scripts.json scripts/verify-published-editor-audit.ts && ts-node --project tsconfig.scripts.json scripts/verify-publish-image-audit.ts && ts-node --project tsconfig.scripts.json scripts/verify-shopping-thumbnail-copy.ts",
    "test:experience-context": "ts-node --project tsconfig.scripts.json scripts/verify-experience-context.ts",
    "test:product-substance": "ts-node --project tsconfig.scripts.json scripts/verify-product-substance-context.ts",
    "test:writing-structure": "ts-node --project tsconfig.scripts.json scripts/verify-writing-structure-guide.ts",
    "test:osaka-audit": "tsx scripts/verify-travel-scene-context.ts && ts-node --project tsconfig.scripts.json scripts/verify-content-readiness-failures.ts && tsx scripts/verify-osaka-editorial-contract.ts",
    "test:quality-repair": "ts-node --project tsconfig.scripts.json scripts/verify-quality-repair-policy.ts",
    "test:editorial-calibration": "tsx scripts/verify-editorial-gate-calibration.ts",
    "test:text-model-policy": "ts-node --project tsconfig.scripts.json scripts/verify-text-model-policy.ts && node scripts/verify-codex-model-default.cjs",
    "test:topic-publish": "tsx scripts/verify-topic-publish-correctness.ts",
    "test:operational-safety": "node --test src/lib/operational-correctness.test.cjs src/lib/remote-agent-completion.test.cjs",
    "test:image-resume": "ts-node --project tsconfig.scripts.json scripts/verify-image-resume-speed.ts",
    "test:mcp-contract": "tsx --test src/lib/brandlink-product-list.test.ts",
    "test:draft-snapshot": "npx ts-node --project tsconfig.scripts.json scripts/verify-draft-snapshot-contract.ts",
    "test:section-images": "npx ts-node --project tsconfig.scripts.json scripts/verify-section-image-repair.ts",
    "test:package-qc-reconcile": "npx ts-node --project tsconfig.scripts.json scripts/verify-package-qc-reconcile.ts",
    "test:publish-image-cleanup": "npx ts-node --project tsconfig.scripts.json scripts/verify-publish-image-cleanup.ts",
    "test:image-batch-progress": "npx ts-node --project tsconfig.scripts.json scripts/verify-image-batch-progress.ts",
    "test:product-section-image-review": "npx ts-node --project tsconfig.scripts.json scripts/verify-product-section-image-review.ts",
    "test:topic-templates": "tsx scripts/verify-topic-templates.ts",
    "test:post-angles": "tsx scripts/verify-post-angles.ts",
    "test:detail-vision": "tsx scripts/verify-detail-vision-and-research.ts",
    "test:title-planner": "tsx scripts/verify-title-planner.ts",
    "test:experience-notes": "tsx scripts/verify-experience-notes.ts",
    "test:photoreal": "tsx scripts/verify-photoreal-prompts.ts",
    "test:codex-image": "tsx scripts/verify-codex-image-generation.ts",
    "test:draft-reliability": "tsx scripts/verify-draft-reliability.ts",
    "test:proposal-audit": "tsx scripts/verify-product-proposal-audit.ts",
    "test:image-replan": "tsx scripts/verify-image-coverage-replan.ts",
    "test:writing-harness": "npx ts-node --project tsconfig.scripts.json scripts/verify-writing-prompt-contract.ts",
    "test:writing-timeouts": "npx ts-node --project tsconfig.scripts.json scripts/verify-writing-timeouts.ts",
    "test:image-timeouts": "npx ts-node --project tsconfig.scripts.json scripts/verify-image-timeout-policy.ts",
    "test:thumbnail-image-wait": "npx ts-node --project tsconfig.scripts.json scripts/verify-thumbnail-image-wait.ts",
    "test:local-json-fetch": "npx ts-node --project tsconfig.scripts.json scripts/verify-local-json-fetch.ts",
    "test:generated-image-selectors": "npx ts-node --project tsconfig.scripts.json scripts/verify-chatgpt-generated-image-selectors.ts",
    "test:naver-login": "npx ts-node --project tsconfig.scripts.json scripts/verify-naver-login-flow.ts",
    "test:auto-update": "node scripts/verify-auto-update-manager.mjs",
    "test:repository-techniques": "npx ts-node --project tsconfig.scripts.json scripts/verify-repository-techniques.ts",
    "test:thumbnail-studio": "npx ts-node --project tsconfig.scripts.json scripts/verify-product-thumbnail-studio.ts",
    "test:product-image-lock": "npx ts-node --project tsconfig.scripts.json scripts/verify-product-image-lock.ts",
    "test:product-detail-image": "npx ts-node --project tsconfig.scripts.json scripts/verify-product-detail-image.ts",
    "test:gpt-thumbnail-bridge": "npx ts-node --project tsconfig.scripts.json scripts/verify-gpt-thumbnail-bridge.ts",
    "test:naver-blog-profile": "npx ts-node --project tsconfig.scripts.json scripts/verify-naver-blog-profile.ts",
    "test:brand-post-package": "npx ts-node --project tsconfig.scripts.json scripts/verify-brand-post-package.ts",
    "test:post-spec": "npx ts-node --project tsconfig.scripts.json scripts/verify-post-spec.ts",
    "test:thumbnail-gen": "npx ts-node --project tsconfig.scripts.json scripts/verify-thumbnail-gen.ts",
    "test:brandlink-product-list": "npx ts-node --project tsconfig.scripts.json scripts/verify-brandlink-product-list.ts",
    "test:brand-sync-by-brand": "npx ts-node --project tsconfig.scripts.json scripts/verify-brand-sync-by-brand.ts",
    "test:brand-post-quality": "npx ts-node --project tsconfig.scripts.json scripts/verify-brand-post-quality-reinforcement.ts",
    "test:chatgpt-browser-automation": "npx ts-node --project tsconfig.scripts.json scripts/verify-chatgpt-browser-automation.ts",
    "test:chatgpt-browser-ui": "node scripts/verify-chatgpt-browser-mode-ui.mjs",
    "test:codex-draft-provider": "npx ts-node --project tsconfig.scripts.json scripts/verify-codex-draft-provider.ts",
    "test:fixed-draft-settings": "tsx scripts/verify-fixed-draft-settings.ts",
    "test:post-composition": "npx ts-node --project tsconfig.scripts.json scripts/verify-post-composition-contract.ts",
    "test:bulk-schedule-plan": "npx ts-node --project tsconfig.scripts.json scripts/verify-bulk-schedule-plan.ts",
    "test:naver-schedule-submission": "npx ts-node --project tsconfig.scripts.json scripts/verify-naver-schedule-submission.ts",
    "test:image-dedup": "npx ts-node --project tsconfig.scripts.json scripts/verify-image-dedup.ts",
    "test:brandlink-image-readiness": "npx ts-node --project tsconfig.scripts.json scripts/verify-brandlink-image-readiness.ts",
    "test:image-collage": "npx ts-node --project tsconfig.scripts.json scripts/verify-image-collage.ts",
    "test:thumbnail-styles": "npx ts-node --project tsconfig.scripts.json scripts/verify-thumbnail-styles.ts",
    "test:connect-detection": "npx ts-node --project tsconfig.scripts.json scripts/verify-connect-item-detection.ts",
    "test:connect-store": "npx ts-node --project tsconfig.scripts.json scripts/verify-connect-contract-store.ts",
    "test:connect-editor-insertion": "npx ts-node --project tsconfig.scripts.json scripts/verify-connect-editor-insertion.ts",
    "test:travel-editorial": "npx ts-node --project tsconfig.scripts.json scripts/verify-travel-editorial-plan.ts",
    "test:travel-draft-resilience": "npx ts-node --project tsconfig.scripts.json scripts/verify-travel-draft-resilience.ts",
    "test:travel-image-quality": "npx ts-node --project tsconfig.scripts.json scripts/verify-travel-image-quality.ts",
    "test:title-rules": "npx ts-node --project tsconfig.scripts.json scripts/verify-title-rules.ts",
    "test:api-auth": "npx ts-node --project tsconfig.scripts.json scripts/verify-api-auth.ts",
    "test:packaged-update": "pwsh -NoProfile -File scripts/verify-packaged-auto-update.ps1",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "login": "npx ts-node --project tsconfig.scripts.json scripts/login.ts",
    "publish": "npx ts-node --project tsconfig.scripts.json scripts/simple-agent.ts",
    "review": "npx ts-node --project tsconfig.scripts.json scripts/review-agent.ts",
    "topic": "npx ts-node --project tsconfig.scripts.json scripts/topic-agent.ts",
    "brandconnect:seasonal": "npx ts-node --project tsconfig.scripts.json scripts/brandconnect-seasonal-register.ts",
    "publish:bulk-schedule": "npx ts-node --project tsconfig.scripts.json scripts/bulk-schedule-publish.ts",
    "db:studio": "npx prisma studio",
    "db:push": "npx prisma db push",
    "site:install": "npm ci --prefix apps/sites",
    "site:dev": "npm run dev --prefix apps/sites",
    "site:build": "npm run build --prefix apps/sites",
    "site:lint": "npm run lint --prefix apps/sites",
    "site:typecheck": "npx --prefix apps/sites tsc --noEmit -p apps/sites/tsconfig.json",
    "site:db:generate": "npm run db:generate --prefix apps/sites",
    "site:update:publish": "npm run update:publish --prefix apps/sites",
    "site:update:verify": "npm run update:verify --prefix apps/sites"
  },
  "main": "scripts/electron/main.cjs",
  "dependencies": {
    "@openai/codex-sdk": "^0.156.1",
    "@prisma/client": "^5.22.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "next": "^16.3.3",
    "openai": "^6.16.0",
    "playwright": "1.62.1",
    "playwright-extra": "^4.3.6",
    "pretendard": "1.3.9",
    "prisma": "^5.22.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "uuid": "^13.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "20.19.30",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13"
  },
  "build": {
    "beforePack": "scripts/electron/before-pack.cjs",
    "afterPack": "scripts/electron/after-pack.cjs",
    "appId": "com.jakeshin.naver-bc-automation",
    "productName": "BrandConnect Automation",
    "asar": false,
    "directories": {
      "output": "out",
      "buildResources": "resources"
    },
    "files": [
      "scripts/**/*",
      "!scripts/tmp-*",
      "!scripts/diagnose-single-section-image.cjs",
      "!scripts/apply-saved-section-image.ts",
      "!scripts/inspect-image-conversation.ts",
      "!scripts/qa-draft-ui-server.mjs",
      "!scripts/verify-saved-text-revalidation-offline.ts",
      ".next/**/*",
      "!.next/cache/**/*",
      "!.next/dev/**/*",
      "public/**/*",
      "next.config.ts",
      "package.json",
      "node_modules/**/*",
      "!node_modules/pretendard/**/*",
      "prisma/**/*",
      "src/**/*",
      "next-env.d.ts",
      "tsconfig.json",
      "tsconfig.scripts.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "node_modules/pretendard/dist/web/static/woff2/Pretendard-Bold.woff2",
        "to": "fonts/Pretendard-Bold.woff2"
      },
      {
        "from": "node_modules/pretendard/dist/web/static/woff2/Pretendard-ExtraBold.woff2",
        "to": "fonts/Pretendard-ExtraBold.woff2"
      },
      {
        "from": "node_modules/pretendard/dist/LICENSE.txt",
        "to": "licenses/Pretendard-OFL.txt"
      },
      {
        "from": "resources/tesseract",
        "to": "tesseract"
      }
    ],
    "extraMetadata": {
      "main": "scripts/electron/main.cjs"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://blogautomcp.hiway350051.chatgpt.site/api/updates/windows",
        "channel": "latest",
        "useMultipleRangeRequest": false
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "artifactName": "BrandConnect-Automation-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false,
    "protocols": [
      {
        "name": "BlogAutoMCP",
        "schemes": [
          "blogautomcp"
        ]
      }
    ]
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "^4.1.18",
    "lightningcss-win32-x64-msvc": "^1.30.2"
  }
}
