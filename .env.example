# ===========================================
# AI Provider
# ===========================================
AI_PROVIDER="openai"

# OpenAI API Key (required if AI_PROVIDER=openai)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Browser GPT mode (ChatGPT 웹 로그인 세션 사용)
# 기본 발행 흐름에서는 ChatGPT 브라우저를 열지 않습니다.
# true로 설정하려면 ALLOW_CHATGPT_BROWSER_MODE도 true로 명시해야 합니다.
BROWSER_GPT_MODE="false"
ALLOW_CHATGPT_BROWSER_MODE="false"

# 상품글은 기본적으로 Custom GPT 2차 윤문을 띄우지 않고, 생성 결과를 로컬 윤문/배치 레이어로 마무리합니다.
CHATGPT_USE_CUSTOM_GPTS="false"
CHATGPT_DIRECT_ONLY="true"
CHATGPT_SKIP_POLISH="true"
HUMAN_MOBILE_POLISH_ENABLED="true"

# OpenAI/Gemini API 생성 실패 또는 키 누락 시 상품 정보 기반 로컬 초안으로 대체
PRODUCT_POST_LOCAL_FALLBACK_ENABLED="true"

# true면 로컬 OpenCrab 네이버블로그 상위리서치 팩/워크플로우를 상품글 기획과 작성 프롬프트에 반영
OPENCRAB_SEO_BRIEF_ENABLED="true"
OPENCRAB_SEO_RESEARCH_JSON=""
OPENCRAB_SEO_WORKFLOW_JSON=""

# ChatGPT 1차 작성 GPT URL (기본: ChatGPT 홈)
# 특정 GPTs를 쓰려면 해당 GPT URL을 넣으세요.
CHATGPT_GPT_URL_DRAFT="https://chatgpt.com/g/g-69044e83643481918a83e45a0bfec330-jepum-ribyu-jagseong-v11-dapeojuneunnamja"

# ChatGPT 2차 다듬기 GPT URL (미설정 시 DRAFT URL 사용)
CHATGPT_GPT_URL_POLISH="https://chatgpt.com/g/g-683347512adc8191bd26d40336990cb1-seo-coejeoghwa-jadong-geul-byeonhwan-v5-0-dapeojuneunnamja"

# 주제 기반(Topic Agent) 글 작성 GPT URL
CHATGPT_GPT_URL_TOPIC="https://chatgpt.com/g/g-690490188af4819188bc1da73019a60f-jeongboseong-beomyong-isyu-geul-saengseonggi-v11-dapeojuneunnamja"

# 주제글 이미지 생성용 ChatGPT URL
# 기본은 전용 이미지 Custom GPT를 사용합니다. 다른 GPT를 쓰고 싶을 때만 덮어쓰세요.
CHATGPT_GPT_URL_IMAGE="https://chatgpt.com/g/g-69044d98b1f08191b96ca4293c6c8156-jeongboseong-imiji-saengseong-v11-dapeojuneunnamja"

# 주제글 AI 이미지 생성은 기본적으로 ChatGPT 로그인/구독 세션을 사용합니다.
# API 과금 방식으로 daedal CLI(gpt-image-2)를 쓰고 싶을 때만 true로 바꾸세요.
# 설치: cargo install --git https://github.com/Hostingglobal-Tech/daedal --locked
# daedal은 실제 OPENAI_API_KEY가 있을 때만 실행되며, 실패하면 기존 ChatGPT/TopicCraft 이미지 경로로 폴백합니다.
TOPIC_PIPELINE_DAEDAL_ENABLED="false"
TOPIC_PIPELINE_DAEDAL_BIN="daedal"
TOPIC_PIPELINE_DAEDAL_PRESET="slide"
TOPIC_PIPELINE_DAEDAL_SIZE=""
TOPIC_PIPELINE_DAEDAL_QUALITY=""
TOPIC_PIPELINE_DAEDAL_MODEL=""
TOPIC_PIPELINE_DAEDAL_IMAGE_TIMEOUT_MS="180000"

# Unsplash API Key (고품질 이미지 수급용)
UNSPLASH_ACCESS_KEY=""

# Pexels API Key (현재 topic 이미지 파이프라인과 더 잘 맞는 stock source)
PEXELS_API_KEY=""

# 주제글 자동 리서치
# true면 사용자가 출처 URL을 넣지 않아도 주제/키워드로 참고 소스를 자동 탐색합니다.
TOPIC_AUTO_RESEARCH_ENABLED="true"
TOPIC_AUTO_RESEARCH_MAX_SOURCES="4"
TOPIC_AUTO_RESEARCH_TIMEOUT_MS="7000"

# 선택: 네이버 검색 OpenAPI를 쓰면 자동 리서치 소스 품질이 좋아집니다.
# 미설정 시 DuckDuckGo HTML 검색을 best-effort 폴백으로 사용합니다.
NAVER_SEARCH_CLIENT_ID=""
NAVER_SEARCH_CLIENT_SECRET=""

# true면 generic fallback(LoremFlickr/Picsum/DummyImage)을 마지막 수단으로 허용
# 운영 환경에서는 false 권장
TOPIC_PIPELINE_ALLOW_GENERIC_IMAGE_FALLBACK="false"

# 레거시 단일 URL (미설정 권장, 하위호환용)
CHATGPT_GPT_URL="https://chatgpt.com/"

# Browser GPT 응답 대기 시간(ms)
CHATGPT_TIMEOUT_MS="180000"

# GPT 응답 감시 설정
# - IDLE: 생성중/텍스트변화 등 "진행 신호"가 없을 때 중단 기준
# - MAX: 전체 대기 상한선
CHATGPT_RESPONSE_IDLE_TIMEOUT_MS="180000"
CHATGPT_RESPONSE_MAX_TIMEOUT_MS="900000"

# ChatGPT 로그인 감지 최대 대기 시간(ms)
CHATGPT_LOGIN_TIMEOUT_MS="600000"

# ChatGPT 로그인 스크립트 동작 모드
# true: 브라우저 로그인 후 Enter를 눌러 수동 확정(권장)
# false: 자동 감지 + 테스트 프롬프트 검증
CHATGPT_LOGIN_MANUAL_CONFIRM="true"

# login:chatgpt에서 커스텀 GPT 접근 가능 여부까지 검증
# (계정이 다르면 "접근 불가/찾을 수 없음"으로 실패 처리)
CHATGPT_VERIFY_CUSTOM_GPTS="true"

# login:chatgpt에서 테스트 프롬프트 전송으로 응답까지 검증할지 여부
# UI 변경 영향이 있어 기본값은 false 권장
CHATGPT_LOGIN_USE_PROBE="false"

# ChatGPT 로그인 유지 모드 (고정 브라우저 프로필 사용)
CHATGPT_USE_PERSISTENT_PROFILE="true"

# ChatGPT 자동화 시작 전 준비 상태 확인 대기 시간(ms)
CHATGPT_READY_TIMEOUT_MS="20000"

# 준비 상태 확인 중 응답 probe까지 보낼지 여부
# true면 "세션 점검입니다. OK..." 테스트를 1회 보냅니다.
CHATGPT_HEALTHCHECK_USE_PROBE="false"

# 대상 GPT 진입 실패 시 재시도 횟수
CHATGPT_TARGET_RECOVERY_ATTEMPTS="1"

# ChatGPT 이미지 생성 완료 대기 시간(ms)
CHATGPT_IMAGE_WAIT_MS="60000"

# 주제글용 ChatGPT 이미지 배치 전체 타임아웃(ms)
TOPIC_PIPELINE_CHATGPT_IMAGE_BATCH_TIMEOUT_MS="120000"

# true면 매 요청마다 격리된 새 브라우저 컨텍스트로 실행
# 보안 챌린지가 잦으면 false(기본) + CHATGPT_FORCE_NEW_CHAT=true 조합을 권장
CHATGPT_RUN_ISOLATED_CONTEXT="false"

# true면 Custom GPT 진입 후 "새 대화"를 눌러 컨텍스트를 초기화
CHATGPT_FORCE_NEW_CHAT="true"

# true면 Custom GPT URL에 temporary-chat=true를 붙여 임시 대화 모드 사용
CHATGPT_USE_TEMPORARY_CHAT="false"

# true면 GPT 가이드 상호작용 모드 사용
# (질문이 오면 답변하고, 구조화된 최종 응답이 올 때까지 대화 지속)
CHATGPT_GUIDED_MODE="true"

# 가이드 상호작용 최대 왕복 횟수
CHATGPT_GUIDED_MAX_TURNS="6"

# Draft GPT 단계에서 출력 형식을 모바일(2번)로 고정
CHATGPT_FORCE_MOBILE_VERSION="true"

# Draft GPT 4단계(소제목 개수) 기본값
CHATGPT_DEFAULT_SUBTITLE_COUNT="5"

# Draft/Polish GPT에 첨부할 이미지 최대 개수 (0이면 비활성화)
CHATGPT_IMAGE_CONTEXT_MAX="4"

# true면 Draft GPT에 수집 이미지를 첨부
CHATGPT_ATTACH_IMAGES_TO_DRAFT="true"

# true면 Polish(SEO) GPT에 수집 이미지를 첨부
CHATGPT_ATTACH_IMAGES_TO_POLISH="true"

# ChatGPT 고정 브라우저 프로필 경로 (미설정 시 기본 경로 사용)
CHATGPT_USER_DATA_DIR=""

# 커스텀 GPT가 질문형 응답만 줄 때 ChatGPT 기본 모델로 1회 폴백
CHATGPT_FALLBACK_TO_BASE="false"

# true면 글 생성까지만 수행하고 발행은 하지 않음 (디버그용)
DRY_RUN_GENERATE_ONLY="false"

# true면 생성된 제목/본문/해시태그를 logs/generated/*.json으로 저장
DEBUG_SAVE_GENERATED_POST="false"

# true면 상품글 발행 전 상품명/본문/고지/체험단정/수수료율/대표이미지 게이트를 검사
BRANDLINK_CONTENT_READINESS_ENABLED="true"

# true면 판매페이지 대표 이미지를 확정하지 못한 상품글은 발행 전 보류
BRANDLINK_REQUIRE_REPRESENTATIVE_IMAGE="true"

# true면 발행 전 ProductThumbnail.md 기준의 생성형 제품 썸네일을 만들어 첫 이미지로 업로드
THUMBNAIL_AUTOGEN_ENABLED="true"

# true면 ChatGPT 이미지 생성 GPT에 판매페이지 대표 이미지를 첨부해 완성형 썸네일 생성
# 본문 작성 GPT와 별도로, 썸네일 생성형 경로만 OAuth 브라우저 세션으로 허용할 수 있습니다.
PRODUCT_THUMBNAIL_CHATGPT_ENABLED="false"
PRODUCT_THUMBNAIL_ALLOW_CHATGPT_BROWSER_MODE="false"
PRODUCT_THUMBNAIL_CHATGPT_BASE_FALLBACK_ENABLED="false"

# true면 GPT를 열지 않고 scripts/generate-thumbnail.py로 실제 JPG 썸네일을 만들어 첫 이미지로 업로드
PRODUCT_THUMBNAIL_LOCAL_SCRIPT_ENABLED="true"

# true면 ChatGPT/Codex 이미지 생성 파일이 없을 때 판매페이지 대표 이미지 기반 로컬 썸네일 생성
PRODUCT_THUMBNAIL_COMPOSITE_FALLBACK_ENABLED="false"

# ChatGPT/OAuth 이미지 생성 실패 시 Codex 내장 imagegen 결과 파일을 썸네일로 사용
PRODUCT_THUMBNAIL_CODEX_IMAGEGEN_FALLBACK_ENABLED="true"
PRODUCT_THUMBNAIL_CODEX_IMAGEGEN_PATH=""
PRODUCT_THUMBNAIL_CODEX_IMAGEGEN_REQUEST_DIR=""

# 제품 썸네일 전용 이미지 생성 GPT URL. 비우면 CHATGPT_GPT_URL_IMAGE를 사용
CHATGPT_GPT_URL_PRODUCT_THUMBNAIL=""

# 생성형 썸네일 이미지 대기 시간(ms)
PRODUCT_THUMBNAIL_IMAGE_WAIT_MS="60000"

# Gemini is not used by the topic publishing pipeline.

# ===========================================
# Naver Blog Settings
# ===========================================
# Your Naver Blog ID (the part after blog.naver.com/)
NAVER_BLOG_ID="your_blog_id"

# ===========================================
# Database (do not modify)
# ===========================================
DATABASE_URL="file:./dev.db"

# ===========================================
# Optional API protection
# ===========================================
# When set, write APIs require `x-admin-api-key` header.
ADMIN_API_KEY=""

# When set, /api/schedule/cron requires `x-cron-secret` header
# or `Authorization: Bearer <secret>`.
CRON_SECRET=""

# ===========================================
# BrandConnect (쇼핑커넥트 / 여행커넥트)
# ===========================================
# 기본으로 열 브랜드커넥트 카테고리 URL. 비워두면 코드에 내장된 예시 주소를 쓰므로,
# 본인 계정의 주소를 넣는 것을 권장한다.
# 예: https://brandconnect.naver.com/<spaceId>/affiliate/products/category/<categoryId>
BRANDCONNECT_SHOPPING_CATEGORY_URL=""

# 여행커넥트 목록 화면 URL. 비워두면 로그인된 세션에서 자동으로 찾는다.
BRANDCONNECT_TRAVEL_CATEGORY_URL=""

# 옵션 불러오기 동작 조절.
# 개별 API 호출 타임아웃(ms). 값이 없으면 소켓이 물릴 때 요청이 끝나지 않는다.
BRANDCONNECT_REQUEST_TIMEOUT_MS="8000"
# 옵션 불러오기 전체 예산(ms). 초과하면 지금까지 모은 결과를 부분 응답으로 돌려준다.
BRANDCONNECT_OPTION_BUDGET_MS="45000"
# BrandConnect API 동시 호출 수.
BRANDCONNECT_REQUEST_CONCURRENCY="6"
# 불러올 카테고리/상품 개수 상한.
BRANDCONNECT_OPTION_CATEGORY_LIMIT="36"
BRANDCONNECT_OPTION_PRODUCT_LIMIT="60"

# 프로모션 문구를 헤드리스 브라우저로 한 번 더 훑는 기능.
# 브랜드커넥트가 headless Chrome에서 멈추는 경우가 있어 기본은 꺼져 있다.
# 켜더라도 아래 시간 안에서만 돌고, 넘기면 그냥 건너뛴다.
BRANDCONNECT_RENDERED_PROMOTION_SCAN_ENABLED="false"
BRANDCONNECT_RENDERED_OPTION_TIMEOUT_MS="20000"

# 여행 계약 자동 캡처를 헤드리스로 돌릴지 여부. 기본은 일반 창(false)이다.
BRANDCONNECT_CAPTURE_HEADLESS="false"

# ===========================================
# 제품 썸네일 생성 (Images API)
# ===========================================
# OPENAI_API_KEY가 있으면 판매페이지 제품 이미지를 레퍼런스로 넣은
# 이미지 생성(image-to-image)으로 대표 썸네일을 만든다. 실패하거나 QC에
# 걸리면 큰 글자 로컬 합성 썸네일로 자동 대체된다.
PRODUCT_THUMBNAIL_IMAGE_API_ENABLED="true"
# gpt-image-2: 한글 텍스트 렌더링·원본 보존이 좋은 최신 모델. 계정에 접근 권한이
# 없으면 자동으로 gpt-image-1로 한 번 내려서 재시도한다.
PRODUCT_THUMBNAIL_IMAGE_MODEL="gpt-image-2"
PRODUCT_THUMBNAIL_IMAGE_QUALITY="high"
PRODUCT_THUMBNAIL_IMAGE_SIZE="1536x1024"
# GEMINI_API_KEY가 있으면 생성 결과의 한글 오탈자·제품명 누락·잘림을 검사한다.
PRODUCT_THUMBNAIL_IMAGE_QC_ENABLED="true"

# ===========================================
# 글쓰기 자연스러움 (AI 티 제거)
# ===========================================
# 생성된 본문의 번역투·상투구·기계적 구조를 점수화해, 기준 이상이면 한 번 재작성한다.
BLOG_HUMANIZE_REWRITE_ENABLED="true"
BLOG_HUMANIZE_REWRITE_THRESHOLD="10"

# ===========================================
# 네이버 검색 노출 글쓰기
# ===========================================
# 해시태그 개수. 상위 노출 글 실측 기준 3~5개 (과다 태그는 키워드 남용 스팸 신호).
NAVER_BLOG_HASHTAG_COUNT="5"
