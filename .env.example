# ===========================================
# AI Provider (openai or gemini)
# ===========================================
AI_PROVIDER="openai"

# OpenAI API Key (required if AI_PROVIDER=openai)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Browser GPT mode (ChatGPT 웹 로그인 세션 사용)
# true로 설정하면 OPENAI_API_KEY 없이 playwright로 ChatGPT를 자동 조작해 글을 생성/다듬습니다.
BROWSER_GPT_MODE="false"

# ChatGPT 1차 작성 GPT URL (기본: ChatGPT 홈)
# 특정 GPTs를 쓰려면 해당 GPT URL을 넣으세요.
CHATGPT_GPT_URL_DRAFT="https://chatgpt.com/g/g-69044e83643481918a83e45a0bfec330-jepum-ribyu-jagseong-v11-dapeojuneunnamja"

# ChatGPT 2차 다듬기 GPT URL (미설정 시 DRAFT URL 사용)
CHATGPT_GPT_URL_POLISH="https://chatgpt.com/g/g-683347512adc8191bd26d40336990cb1-seo-coejeoghwa-jadong-geul-byeonhwan-v5-0-dapeojuneunnamja"

# 레거시 단일 URL (미설정 권장, 하위호환용)
CHATGPT_GPT_URL="https://chatgpt.com/"

# Browser GPT 응답 대기 시간(ms)
CHATGPT_TIMEOUT_MS="180000"

# GPT 응답 감시 설정
# - IDLE: 생성중/텍스트변화 등 "진행 신호"가 없을 때 중단 기준
# - MAX: 전체 대기 상한선
CHATGPT_RESPONSE_IDLE_TIMEOUT_MS="180000"
CHATGPT_RESPONSE_MAX_TIMEOUT_MS="900000"

# ChatGPT 로그인 감지 최대 대기 시간(ms)
CHATGPT_LOGIN_TIMEOUT_MS="600000"

# ChatGPT 로그인 스크립트 동작 모드
# true: 브라우저 로그인 후 Enter를 눌러 수동 확정(권장)
# false: 자동 감지 + 테스트 프롬프트 검증
CHATGPT_LOGIN_MANUAL_CONFIRM="true"

# login:chatgpt에서 커스텀 GPT 접근 가능 여부까지 검증
# (계정이 다르면 "접근 불가/찾을 수 없음"으로 실패 처리)
CHATGPT_VERIFY_CUSTOM_GPTS="true"

# login:chatgpt에서 테스트 프롬프트 전송으로 응답까지 검증할지 여부
# UI 변경 영향이 있어 기본값은 false 권장
CHATGPT_LOGIN_USE_PROBE="false"

# ChatGPT 로그인 유지 모드 (고정 브라우저 프로필 사용)
CHATGPT_USE_PERSISTENT_PROFILE="true"

# true면 매 요청마다 격리된 새 브라우저 컨텍스트로 실행
# 보안 챌린지가 잦으면 false(기본) + CHATGPT_FORCE_NEW_CHAT=true 조합을 권장
CHATGPT_RUN_ISOLATED_CONTEXT="false"

# true면 Custom GPT 진입 후 "새 대화"를 눌러 컨텍스트를 초기화
CHATGPT_FORCE_NEW_CHAT="true"

# true면 Custom GPT URL에 temporary-chat=true를 붙여 임시 대화 모드 사용
CHATGPT_USE_TEMPORARY_CHAT="false"

# true면 GPT 가이드 상호작용 모드 사용
# (질문이 오면 답변하고, 구조화된 최종 응답이 올 때까지 대화 지속)
CHATGPT_GUIDED_MODE="true"

# 가이드 상호작용 최대 왕복 횟수
CHATGPT_GUIDED_MAX_TURNS="6"

# Draft GPT 단계에서 출력 형식을 모바일(2번)로 고정
CHATGPT_FORCE_MOBILE_VERSION="true"

# Draft GPT 4단계(소제목 개수) 기본값
CHATGPT_DEFAULT_SUBTITLE_COUNT="5"

# Draft/Polish GPT에 첨부할 이미지 최대 개수 (0이면 비활성화)
CHATGPT_IMAGE_CONTEXT_MAX="4"

# true면 Draft GPT에 수집 이미지를 첨부
CHATGPT_ATTACH_IMAGES_TO_DRAFT="true"

# true면 Polish(SEO) GPT에 수집 이미지를 첨부
CHATGPT_ATTACH_IMAGES_TO_POLISH="true"

# ChatGPT 고정 브라우저 프로필 경로 (미설정 시 기본 경로 사용)
CHATGPT_USER_DATA_DIR=""

# 커스텀 GPT가 질문형 응답만 줄 때 ChatGPT 기본 모델로 1회 폴백
CHATGPT_FALLBACK_TO_BASE="false"

# true면 글 생성까지만 수행하고 발행은 하지 않음 (디버그용)
DRY_RUN_GENERATE_ONLY="false"

# true면 생성된 제목/본문/해시태그를 logs/generated/*.json으로 저장
DEBUG_SAVE_GENERATED_POST="false"

# true면 발행 전 상단 텍스트 + 중간 누끼컷 대표 썸네일을 자동 생성해 첫 이미지로 업로드
THUMBNAIL_AUTOGEN_ENABLED="true"

# Gemini API Key (required if AI_PROVIDER=gemini)
# Get it from: https://aistudio.google.com/app/apikey (FREE!)
GEMINI_API_KEY="AIza..."

# ===========================================
# Naver Blog Settings
# ===========================================
# Your Naver Blog ID (the part after blog.naver.com/)
NAVER_BLOG_ID="your_blog_id"

# ===========================================
# Database (do not modify)
# ===========================================
DATABASE_URL="file:./dev.db"

# ===========================================
# Optional API protection
# ===========================================
# When set, write APIs require `x-admin-api-key` header.
ADMIN_API_KEY=""

# When set, /api/schedule/cron requires `x-cron-secret` header
# or `Authorization: Bearer <secret>`.
CRON_SECRET=""
